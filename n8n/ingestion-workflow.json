      ],
      "id": "f8322476-6bcc-4186-898a-7386fe56e16e",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "\nconst text = $input.first().json.text || '';\nconst fileName = $('Webhook').first().binary.file.fileName;\n\nconst words = text.split(/\\s+/).filter(Boolean);\n\nif (words.length === 0) {\n  throw new Error('No text found in PDF. Is it scanned?');\n}\n\nconst size = 200;\nconst overlap = 30;\nconst chunks = [];\n\nfor (let i = 0; i < words.length; i += size - overlap) {\n  chunks.push(words.slice(i, i + size).join(' '));\n\n  if (i + size >= words.length) break;\n}\n\nreturn [{\n  json: {\n    file_name: fileName,\n    chunks\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "3622fc00-755a-477b-a348-a6ab0a220c1b",
      "name": "Chunk text"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/embed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"texts\": $json.chunks } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        0
      ],
      "id": "e737a2d7-962d-4e2e-a16e-fef06fb169b5",
      "name": "Embed"
    },
    {
      "parameters": {
        "jsCode": "\nconst { file_name, chunks } = $('Chunk text').first().json;\nconst embeddings = $input.first().json.embeddings;\n\nif (!embeddings || embeddings.length !== chunks.length) {\n  throw new Error('Chunk count does not match embedding count');\n}\n\nconst rows = chunks.map((content, i) => ({\n  file_name,\n  content,\n  embedding: embeddings[i],\n}));\n\nreturn [{ json: { rows } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "id": "e8c196ab-9028-4c0b-a71f-5cab6bc85b0b",
      "name": "Merge"
    },
